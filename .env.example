NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<backend-only-service-role-key>
SUPABASE_STORAGE_BUCKET=<private-evidence-bucket>
CORS_ORIGINS=http://localhost:5173
COMMERCE_SCHEMA_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=<Paystack-test-secret-key>
